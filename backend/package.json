{
  "name": "highschool-backend",
  "version": "1.0.0",
  "description": "Production High School Management System Backend - PERN Stack",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "predev": "fuser -k 5000/tcp 2>/dev/null || true",
    "dev": "node --watch src/server.js",
    "db:init": "node src/database/init.js",
    "db:seed": "node src/database/seed.js",
    "db:start": "./scripts/start-db.sh",
    "db:stop": "./scripts/stop-db.sh",
    "verify": "node scripts/verify-all.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "ws": "^8.21.3"
  }
}
