# ==============================================================================
# ETHIOHIGHHUB BACKEND ENVIRONMENT TEMPLATE
# Copy this file to .env and replace placeholder values with your production keys
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# PostgreSQL Database (Neon cloud, Supabase, Railway, or self-hosted)
DATABASE_URL=postgresql://username:password@ep-your-cluster.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=your-secure-random-32-byte-hex-string-for-jwt-signing

# Super Administrator Initial Credentials
SUPERADMIN_EMAIL=superadmin@ethiohighhub.com
SUPERADMIN_PASSWORD=SuperAdmin@123

# Frontend Origin for CORS (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-domain.vercel.app,http://localhost:5173

# Cloudinary Storage (For Student Grade 8 Documents, Transcripts, and Profiles)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Chapa Payment Gateway (Ethiopian Birr / Telebirr / CBEBirr / Bank integration)
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your-public-key
CHAPA_SECRET_KEY=CHASECK_TEST-your-secret-key
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret
CHAPA_CALLBACK_URL=https://your-api-domain.onrender.com/api/subscriptions/chapa-webhook
CHAPA_RETURN_URL=https://your-frontend-domain.vercel.app/admin/billing
